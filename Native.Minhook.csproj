<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<OutputType>Library</OutputType>

		<AssemblyVersion>0.0.1</AssemblyVersion>
		<FileVersion>0.0.1</FileVersion>

		<PackageId>Native.Minhook</PackageId>
		<Version>0.0.1</Version>
		<Authors>WinsentShame</Authors>
		<Description>A lightweight, high-performance C# wrapper for MinHook, designed specifically for Native AOT applications. Supports x86/x64 static linking.</Description>
		<PackageTags>minhook;hook;nativeaot;aot;interop;api-hooking;detours;x86;x64;native-interop</PackageTags>

		<PackageLicenseFile>LICENSE</PackageLicenseFile>

		<Title>Native.Minhook</Title>

		<RepositoryUrl>https://github.com/WinsentShame/Native.Minhook</RepositoryUrl>

		<Copyright>Copyright (c) 2026 WinsentShame</Copyright>

		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="Library\Minhook_64.lib" Pack="true" PackagePath="runtimes\win-x64\native\" />
		<None Include="Library\Minhook_86.lib" Pack="true" PackagePath="runtimes\win-x86\native\" />
		<None Include="Library\fix_ultof3.lib" Pack="true" PackagePath="runtimes\win-x86\native\" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Native.Minhook.targets" Pack="true" PackagePath="build\" />
		<None Include="LICENSE" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
	  <None Update="README.md">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

</Project>